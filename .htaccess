Options -Indexes
RewriteEngine On

# 301 redirects: legacy URLs → canonical pages. These run before the www/https
# rules and redirect straight to the https non-www URL, so every legacy URL
# (www or not, http or https) resolves in a single hop.

# Legacy -remodeling URLs (with or without trailing slash; subpaths carried over)
RewriteRule ^services/basement-remodeling(?:/(.*))?$ https://atlasdesignandbuild.com/services/basement/$1 [R=301,L]
RewriteRule ^services/bathroom-remodeling(?:/(.*))?$ https://atlasdesignandbuild.com/services/bathroom/$1 [R=301,L]
RewriteRule ^services/kitchen-remodeling(?:/(.*))?$ https://atlasdesignandbuild.com/services/kitchen/$1 [R=301,L]

# Old Wix URLs
RewriteRule ^kitchen/?$ https://atlasdesignandbuild.com/services/kitchen/ [R=301,L]
RewriteRule ^bathrooms/?$ https://atlasdesignandbuild.com/services/bathroom/ [R=301,L]
RewriteRule ^basements/?$ https://atlasdesignandbuild.com/services/basement/ [R=301,L]
RewriteRule ^contact-8/?$ https://atlasdesignandbuild.com/contact/ [R=301,L]
RewriteRule ^inquiries/?$ https://atlasdesignandbuild.com/contact/ [R=301,L]
RewriteRule ^home/?$ https://atlasdesignandbuild.com/ [R=301,L]
RewriteRule ^whole-home-additions-1/?$ https://atlasdesignandbuild.com/services/whole-home-renovation/ [R=301,L]

# 301 redirect: add the trailing slash to folder URLs in one hop, straight to the
# https non-www URL (e.g. /services/bathroom/doylestown → /services/bathroom/doylestown/).
# Without this the server adds the slash as an extra hop after the www/https redirects.
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_URI} !/$
RewriteRule ^(.*)$ https://atlasdesignandbuild.com/$1/ [R=301,L]

# 301 redirects: www → non-www, http → https
RewriteCond %{HTTP_HOST} ^www\.atlasdesignandbuild\.com$ [NC]
RewriteRule ^ https://atlasdesignandbuild.com%{REQUEST_URI} [R=301,L]
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://atlasdesignandbuild.com%{REQUEST_URI} [R=301,L]
